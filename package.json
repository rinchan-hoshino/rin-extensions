{
  "name": "@rinchan-hoshino/rin-extensions",
  "version": "0.1.8",
  "private": true,
  "description": "First-party optional extensions for Rin and Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rinchan-hoshino/rin-extensions.git"
  },
  "pi": {
    "extensions": [
      "extensions/codex-usage.ts",
      "extensions/self-improve-reminder.ts",
      "extensions/i18n.ts"
    ]
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
